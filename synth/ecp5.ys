# Lattice ECP5 synthesis of npu_top inside the out-of-context wrapper
# (synth/npu_top_ooc.sv), followed by nextpnr-ecp5 for a post-route Fmax
# (make synth-ecp5). -abc9 maps wide muxes markedly better than the default
# ABC flow in Yosys 0.33 (about 30-40% fewer cells in isolated tests).
read_verilog -sv build/synth/npu_top_ooc.v
hierarchy -check -top npu_top_ooc
proc

# Placement constraint: keep each requant unit's own copy of the shift amount.
# The eight copies are identical, so Yosys would merge them into one register
# that then drives all eight 65-bit shifters across the device (the critical
# path of every seed before this). This is the open-flow counterpart of a
# dont_touch / max_fanout constraint; the RTL is unchanged. The count check
# fails the run if the register names ever change.
select -assert-count 4 requant_unit/w:s1_shift_q requant_unit/w:s2a_shift_q %u requant_unit/w:s2_shift_q %u requant_unit/w:s3_noshift_q %u %ci1:+$dff,$dffe,$adff,$adffe[Q] requant_unit/c:* %i
setattr -set keep 1 requant_unit/w:s1_shift_q requant_unit/w:s2a_shift_q %u requant_unit/w:s2_shift_q %u requant_unit/w:s3_noshift_q %u %ci1:+$dff,$dffe,$adff,$adffe[Q] requant_unit/c:* %i

synth_ecp5 -abc9 -top npu_top_ooc -json build/synth/npu_top_ooc_ecp5.json
tee -o build/synth/ecp5_stat.txt stat
